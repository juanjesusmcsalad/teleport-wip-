local function getStateVal(obj, default)
    if obj == nil then return default end
    if typeof(obj) == "function" then
        local ok, res = pcall(obj)
        if ok and res ~= nil then return res end
    elseif typeof(obj) == "table" then
        local ok, res = pcall(function() return obj() end)
        if ok and res ~= nil then return res end
        if obj.Value ~= nil then return obj.Value end
    else
        return obj
    end
    return default
end

