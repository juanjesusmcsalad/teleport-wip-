local function attachAutoScale(frame, baseW, baseH, fill)
	fill = fill or 0.9
	local scale = Instance.new("UIScale")
	scale.Name = "AutoScale"
	scale.Parent = frame
	local cam
	local camConn
	local function update()
		local c = workspace.CurrentCamera
		local vp = c and c.ViewportSize or Vector2.new(1920, 1080)
		if vp.X < 2 or vp.Y < 2 then return end
		scale.Scale = math.clamp(math.min((vp.X * fill) / baseW, (vp.Y * fill) / baseH, 1), 0.35, 1)

		local pGui = frame.Parent
		local pSize = pGui and pGui:IsA("GuiObject") and pGui.AbsoluteSize or (pGui and pGui:IsA("LayerCollector") and pGui.AbsoluteSize) or vp
		if frame.AnchorPoint == Vector2.zero and frame.Position.X.Scale == 0 and frame.Position.Y.Scale == 0 then
			local curX = math.floor((pSize.X - frame.Size.X.Offset) / 2)
			local curY = math.floor((pSize.Y - frame.Size.Y.Offset) / 2)
			frame.Position = UDim2.new(0, curX, 0, curY)
		end
	end
	local function bindCamera()
		if camConn then camConn:Disconnect() end
		cam = workspace.CurrentCamera
		if cam then
			camConn = Session:Track(cam:GetPropertyChangedSignal("ViewportSize"):Connect(update))
		end
		update()
	end
	Session:Track(workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera))
	frame.Destroying:Connect(function() if camConn then camConn:Disconnect() end end)
	bindCamera()
	return scale
end

