local function executeAutoLevelUp()
    local LevelUp = (Remotes and Remotes.LevelUpSlot) or (game:GetService("ReplicatedStorage"):FindFirstChild("Network") and game:GetService("ReplicatedStorage").Network.PlotService.RE.LevelUpSlot)
    if not LevelUp then return 0 end

    local reserve = tonumber(Config.MinMoneyReserve) or 0
    if reserve > 0 and DataController then
        local currentMoney = getStateVal(DataController.Money, 0)
        if currentMoney <= reserve then return 0 end
    end

    local slots = getStateVal(DataController and DataController.Slots, {})
    local upgradedCount = 0

    for slotIndex = 1, 20 do
        if not ScriptRunning then break end

        -- If slot data is present, only fire for active slots with placed units
        if next(slots) ~= nil then
            local sData = slots[tostring(slotIndex)] or slots[slotIndex]
            if not sData or not sData.unitId then
                continue
            end
        end

        if reserve > 0 and DataController then
            local currentMoney = getStateVal(DataController.Money, 0)
            if currentMoney <= reserve then break end
        end

        LevelUp:FireServer(slotIndex)
        upgradedCount = upgradedCount + 1
        task.wait(0.08)
    end

    return upgradedCount
end

local function executeAutoClaimQuests()
    local ClaimRE = (Remotes and Remotes.QuestClaim) or (game:GetService("ReplicatedStorage"):FindFirstChild("Network") and game:GetService("ReplicatedStorage").Network.QuestService.RE.Claim)
    if not ClaimRE or not DataController or not QuestConfig or not QuestConfig.Periods then return 0 end

    local qData = getStateVal(DataController.Quests, {})
    local claimedCount = 0

    for periodName, periodConfig in pairs(QuestConfig.Periods) do
        local pData = qData[periodName]
        if pData and pData.expiresAt and pData.progress and periodConfig.quests then
            local claimed = pData.claimed or {}
            for _, quest in ipairs(periodConfig.quests) do
                local qid = quest.id
                local progress = pData.progress[qid] or 0
                local target = quest.target or 0
                if progress >= target and not claimed[qid] then
                    ClaimRE:FireServer(periodName, qid, pData.expiresAt)
                    claimedCount = claimedCount + 1
                    task.wait(0.15)
                end
            end
        end
    end

    return claimedCount
end

