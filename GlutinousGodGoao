local function shouldAutoSell()
    if not Config.AutoSellUnits then return false, 0, 100 end

    local unitCount = countUnitsInInventory()
    local capacity = getInventoryCapacity()
    local rollsBuff = (BuffController and type(BuffController.GetBuff) == "function" and BuffController.GetBuff("Rolls")) or 1

    -- Trigger sell with at least 15 units headroom (or 3x multi-roll burst) so inventory NEVER caps out
    local safeHeadroom = math.max(12, rollsBuff * 3)
    local capacityThreshold = math.max(15, capacity - safeHeadroom)

    if unitCount >= capacityThreshold then
        return true, unitCount, capacity
    end

    -- Also check if a significant pile of unplotted surplus units exists (15+ units)
    if SellUtil and type(SellUtil.CreateSummary) == "function" and DataController then
        local ok, s = pcall(SellUtil.CreateSummary, getStateVal(DataController.Inventory, {}), getStateVal(DataController.Slots, {}))
        if ok and s and s.sales and #s.sales >= 15 then
            return true, unitCount, capacity
        end
    end

    return false, unitCount, capacity
end

