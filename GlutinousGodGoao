local function isUnitProtected(unitId, item)
    if not item then return false, "No item" end
    if item.attributes and item.attributes.locked == true then
        return true, "Locked"
    end

    local name = item.name or ""
    local isShiny = (item.attributes and item.attributes.shiny) or string.find(name, "Shiny")
    if Config.ProtectShiny and isShiny then
        return true, "Shiny"
    end

    local isHaunted = (item.attributes and item.attributes.mutation == "Haunted") or string.find(name, "Haunted")
    if Config.ProtectHaunted and isHaunted then
        return true, "Haunted"
    end

    local cfg = nil
    if EntryRegistry and EntryRegistry.getEntryConfig then
        local ok, c = pcall(EntryRegistry.getEntryConfig, name)
        if ok and c then cfg = c end
    end

    if not cfg or cfg.kind ~= "Unit" then
        return false, "Not a unit"
    end

    -- Rarity Protection
    if Config.AutoLockRarities and Config.ProtectedRarities then
        local rarity = cfg.rarity or "Unknown"
        local isProtectedRarity = false
        if type(Config.ProtectedRarities) == "table" then
            for _, r in ipairs(Config.ProtectedRarities) do
                if r == rarity then isProtectedRarity = true break end
            end
            if not isProtectedRarity then
                for k, v in pairs(Config.ProtectedRarities) do
                    if k == rarity and v == true then isProtectedRarity = true break end
                end
            end
        end
        if isProtectedRarity then
            return true, "Rarity: " .. tostring(rarity)
        end
    end

    -- Character Name Protection
    if Config.AutoLockCharacters and Config.ProtectedCharacters and Config.ProtectedCharacters ~= "" then
        local rawNames = string.split(tostring(Config.ProtectedCharacters), ",")
        local unitNameLower = name:lower()
        for _, n in ipairs(rawNames) do
            local clean = n:gsub("^%s+", ""):gsub("%s+$", ""):lower()
            if clean ~= "" and (unitNameLower == clean or string.find(unitNameLower, clean, 1, true)) then
                return true, "Character: " .. name
            end
        end
    end

    return false, "Unprotected"
end

local lastBatchLockTime = 0
local function scanAndLockProtectedUnits(notify)
    if not ScriptRunning or not DataController then return 0 end
    local SetLockedRE = (Remotes and Remotes.SetLocked)
        or (game:GetService("ReplicatedStorage"):FindFirstChild("Network") and game:GetService("ReplicatedStorage").Network.UnitService.RE.SetLocked)
    if not SetLockedRE then return 0 end

    local inv = getStateVal(DataController.Inventory, {})
    local batchToLock = {}
    local lockedNames = {}
    local lockCount = 0

    for id, item in pairs(inv) do
        if item and type(item) == "table" then
            local isAlreadyLocked = item.attributes and item.attributes.locked == true
            if not isAlreadyLocked then
                local protected, reason = isUnitProtected(id, item)
                if protected then
                    batchToLock[id] = true
                    lockCount = lockCount + 1
                    if #lockedNames < 3 then
                        table.insert(lockedNames, item.name or id)
                    end
                end
            end
        end
    end

    if lockCount > 0 then
        lastBatchLockTime = os.clock()
        SetLockedRE:FireServer(batchToLock)
        if notify and Window and Window.Notify then
            local preview = table.concat(lockedNames, ", ")
            if lockCount > #lockedNames then
                preview = preview .. " (+" .. tostring(lockCount - #lockedNames) .. " more)"
            end
            Window:Notify({
                Title = "Units Auto-Locked! 🔒",
                Desc = string.format("Locked %d unit%s: %s", lockCount, lockCount > 1 and "s" or "", preview),
                Duration = 3.5
            })
        end
    end

    return lockCount
end

