    if not DataController then return nil end
    local owned = getStateVal(DataController.OwnedDice, {})
    for _, d in ipairs(OrderedDiceData) do
        if d.price and d.price > 0 and not owned[d.name] then
            return d
        end
    end
    return nil
end

local function getBestOwnedDice()
    if not DataController then return nil end
    local owned = getStateVal(DataController.OwnedDice, {})
    local best = nil
    for _, d in ipairs(OrderedDiceData) do
        if owned[d.name] or d.name == "Basic" then
            if not best or d.luck > best.luck then
                best = d
            end
        end
    end
    return best
end

