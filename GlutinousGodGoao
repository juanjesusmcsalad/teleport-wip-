end

-- Server-compliant safe travel: smooth traversal at <= 50 studs/s to respect TrickOrTreat MAX_TRAVEL_SPEED (60 studs/s)
local function safeTravelTo(targetPos)
    local root = getRoot()
    if not root then return false end
    local startPos = root.Position
    local dist = (Vector3.new(targetPos.X, 0, targetPos.Z) - Vector3.new(startPos.X, 0, startPos.Z)).Magnitude

    if dist < 8 then
        root.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
        return true
    end

    local speed = 50 -- Under server speed limit of 60 studs/s
    local travelTime = math.max(0.4, dist / speed)
    local elapsed = 0

    while elapsed < travelTime and ScriptRunning do
        local dt = task.wait()
        elapsed = elapsed + dt
        local alpha = math.clamp(elapsed / travelTime, 0, 1)
        local curPos = startPos:Lerp(targetPos, alpha)
        if root and root.Parent then
            root.CFrame = CFrame.new(curPos + Vector3.new(0, 2, 0))
            local hum = getHumanoid()
            if hum then hum.PlatformStand = false end
        else
            break
        end
    end
    if root and root.Parent then
        root.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
    end
    return true
end

