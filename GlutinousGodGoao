    -- Proactively lock any protected units before calculating sales
    if Config.AutoLockRarities or Config.AutoLockCharacters or Config.ProtectShiny or Config.ProtectHaunted then
        pcall(scanAndLockProtectedUnits)
    end

    -- Use official SellUtil.CreateSummary to automatically shield plotted and locked units
    local summary = nil
    if SellUtil and type(SellUtil.CreateSummary) == "function" and DataController then
        local ok, s = pcall(SellUtil.CreateSummary, getStateVal(DataController.Inventory, {}), getStateVal(DataController.Slots, {}))
        if ok and s then summary = s end
    end

    if not summary or not summary.sales or #summary.sales == 0 then
        return 0, 0
    end

    local inv = getStateVal(DataController and DataController.Inventory, {})
    local toSell = {}

    for _, sale in ipairs(summary.sales) do
        local id = sale.key
        local item = inv[id]
        local protected, reason = isUnitProtected(id, item)

        if not protected then
            table.insert(toSell, id)
        end
    end

    local totalSold = 0
    local totalEarned = 0

    if #toSell > 0 then
        for i = 1, #toSell, 100 do
            local chunk = {}
            for j = i, math.min(i + 99, #toSell) do
                table.insert(chunk, toSell[j])
            end
            local ok, earned = pcall(function()
                return SellInv:InvokeServer(chunk)
            end)
            totalSold = totalSold + #chunk
            if ok and typeof(earned) == "number" then
                totalEarned = totalEarned + earned
            end
            if i + 100 <= #toSell then
                task.wait(0.15)
            end
        end
    end

    return totalSold, totalEarned
end

