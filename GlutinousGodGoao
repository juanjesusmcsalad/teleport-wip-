                end
            end
        end
    end
    
    -- 7. LOBBY UPGRADES (GEMS)
    if state.SaveData and state.SaveData.LobbyUpgrades then
        pcall(function()
            local upgrades = {
                LobbyUpgradeShared.BAG_SIZE,
                LobbyUpgradeShared.GRAB_AMOUNT,
                LobbyUpgradeShared.CASH_BOOST,
                LobbyUpgradeShared.GEM_BOOST
