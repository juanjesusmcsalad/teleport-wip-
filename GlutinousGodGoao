                Desc = ok and "Successfully saved configuration to JSON!" or "Failed to save configuration."
            })
        end
    end
})

SettingsSec:Button({
    Title = "Reload Config",
    Desc = "Reloads and restores saved settings from Aether/Configs/AnimeDice.json",
    Callback = function()
        local ok = loadGameConfig()
        if Window and Window.Notify then
            Window:Notify({
                Title = "Config Reloaded",
                Desc = ok and "Successfully reloaded configuration from JSON!" or "Failed to load configuration."
            })
        end
    end
})

SettingsSec:Button({
    Title = "Unload Script",
    Desc = "Terminates all background loops and disconnects events",
    Callback = function()
        if _G.__AnimeDice_Cleanup then
            pcall(_G.__AnimeDice_Cleanup)
        end
        if Window and Window.Notify then
            Window:Notify({
                Title = "Script Unloaded",
                Desc = "Background automation threads and event connections stopped.",
                Duration = 3.0
            })
        end
    end
})

task.defer(function()
    task.wait(0.2)
    pcall(loadGameConfig)
    if Config.HideRollingScreen then
        ensureRollingHidden(true)
    end
    if Config.AutoTower then
        ensureTowerHidden(true)
    end
end)

