        if type(DataController.Money) == "table" and type(DataController.Money.Changed) == "function" then
            trackConn(DataController.Money.Changed(function()
                if Config.AutoRebirth then
                    checkAndFireAutoRebirth()
                end
                updateDashboardStats()
            end))
        end
        if type(DataController.Rebirth) == "table" and type(DataController.Rebirth.Changed) == "function" then
            trackConn(DataController.Rebirth.Changed(updateDashboardStats))
        end
        if type(DataController.Rolls) == "table" and type(DataController.Rolls.Changed) == "function" then
            trackConn(DataController.Rolls.Changed(updateDashboardStats))
        end
        if type(DataController.Dice) == "table" and type(DataController.Dice.Changed) == "function" then
            trackConn(DataController.Dice.Changed(updateDashboardStats))
        end
        if type(DataController.OwnedDice) == "table" and type(DataController.OwnedDice.Observe) == "function" then
            trackConn(DataController.OwnedDice.Observe(updateDashboardStats))
        end
        if type(DataController.Inventory) == "table" and type(DataController.Inventory.Observe) == "function" then
            trackConn(DataController.Inventory.Observe(function()
                pcall(updateCandyProgressUI)
            end))
        end
        if type(DataController.Inventory) == "table" and type(DataController.Inventory.OnKeyAdded) == "function" then
            trackConn(DataController.Inventory.OnKeyAdded(function(key, item)
                if not ScriptRunning then return end
                task.spawn(function()
                    if not Config.AutoLockRarities and not Config.AutoLockCharacters and not Config.ProtectShiny and not Config.ProtectHaunted then
                        return
                    end
                    if not item and DataController.Inventory then
                        local inv = getStateVal(DataController.Inventory, {})
                        item = inv[key]
                    end
                    if not item or (item.attributes and item.attributes.locked == true) then return end

                    local protected, reason = isUnitProtected(key, item)
                    if protected then
                        local SetLockedRE = (Remotes and Remotes.SetLocked)
                            or (game:GetService("ReplicatedStorage"):FindFirstChild("Network") and game:GetService("ReplicatedStorage").Network.UnitService.RE.SetLocked)
                        if SetLockedRE then
                            SetLockedRE:FireServer({ [key] = true })
                            if Window and Window.Notify then
                                Window:Notify({
                                    Title = "Unit Auto-Locked! 🔒",
                                    Desc = string.format("Locked %s (%s)", tostring(item.name or key), tostring(reason)),
                                    Duration = 3.5
                                })
                            end
                        end
                    end
                end)
            end))
        end
    end)
end

